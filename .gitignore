# local images that may be used later
#
# Note: adding a filename here is NOT enough if the file has already been
# committed — .gitignore only applies to untracked files.
# For files already in git, also run:
#     git rm --cached <path>
# The file stays on disk, it just stops being pushed.
#
# Consequence: the files below are NOT included when the repo is cloned. If
# one of them ends up actually used on a page, remove its entry and then
# `git add` it — if you forget, the build fails because the @/public/... import
# won't resolve.

# background that was previously a second option
bg-1.jpg

# candidate for the gym/fitness page
gym.png

# private beach slim
private-beach.jpeg
# private beach wide
private-beach2.jpeg
